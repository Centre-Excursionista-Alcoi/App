<?xml version="1.0" encoding="utf-8"?>
<!-- Backups and device transfers from Android 12. Keep in sync with backup_rules.xml. -->
<data-extraction-rules>
    <!-- The id of this device's restore key (see CredentialManagerRepository): restored onto another device, that
         device would make the server delete a restore key this one may still hold. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="credential_manager.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="credential_manager.xml" />
    </device-transfer>
</data-extraction-rules>
