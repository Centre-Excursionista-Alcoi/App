    "login_browser_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We opened your browser. Check that the code it shows is the one below, and sign in with your passkey. This window will continue by itself."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Hem obert el teu navegador. Comprova que el codi que mostra és el de sota, i inicia sessió amb la teua passkey. Aquesta finestra continuarà soleta."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemos abierto tu navegador. Comprueba que el código que muestra es el de abajo, e inicia sesión con tu passkey. Esta ventana continuará sola."
          }
        }
      }
    },
    "login_browser_title": {
      "extractionState": "manual",
      "localizations": {
