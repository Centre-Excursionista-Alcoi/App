    "login_forgot_password_dialog_action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send Email"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar Correu"
          }
        },
        "es": {
