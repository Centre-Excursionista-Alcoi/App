    "inventory_item_set_manufacturer_details_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some manufacturers include a Data Matrix or serial number with information about the material. The app will try its best to recognize the brand and data."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns fabricants inclouen una Data Matrix o número de sèrie amb informació sobre el material. L'app farà tot el què puga per a reconéixer la marca i les dades."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos fabricantes incluyen una Data Matrix o número de serie con información sobre el material. La app hará todo lo que se pueda para reconocer la marca y los datos."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சில உற்பத்தியாளர்கள் டேட்டா மேட்ரிக்ச் அல்லது பொருள் பற்றிய தகவல்களுடன் வரிசை எண்ணை உள்ளடக்கியுள்ளனர். சூட்டுக்குறி மற்றும் தரவை அடையாளம் காண ஆப்ச் சிறந்த முறையில் முயற்சிக்கும்."
          }
        }
      }
    },
