    "settings_push_connection_message_connected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receiving push notifications. Data will be updated instantly."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebent notificacions push. Les dades s'actualitzaran al moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibiendo notificaciones push. Los datos se actualizarán al momento."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புச் அறிவிப்புகளைப் பெறுகிறது. தரவு உடனடியாக புதுப்பிக்கப்படும்."
          }
        }
      }
    },
    "settings_push_connection_message_disconnected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not receiving push notifications. Data will need to be fetched manually. Restarting the app may reconnect."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'estan rebent notificacions push. Les dades s'hauran de sincronitzar manualment. Reiniciar l'app pot solucionar-ho."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se están recibiendo notificaciones push. Los datos se tendrán que sincronizar manualmente. Reiniciar la app puede solucionarlo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புச் அறிவிப்புகளைப் பெறவில்லை. தரவு கைமுறையாகப் பெறப்பட வேண்டும். பயன்பாட்டை மறுதொடக்கம் செய்வது மீண்டும் இணைக்கப்படலாம்."
          }
        }
      }
    },
