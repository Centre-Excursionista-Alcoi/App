    "management_return_screen_skip_warning_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have not marked all items, this means that the user has not brought them back, and the lending will be kept pendent until all of them have been returned. The user cannot create new lendings until all items have been delivered."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No has marcat tots els elements, això significa que l'usuari no ha tornat tot el material, i el préstec estarà pendent fins que es torne tot. L'usuari no pot crear nous préstecs fins que tot el material haja sigut tornat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No has marcado todos los elementos, lo que significa que el usuario no los ha devuelto, y que el préstamo estará pendiente hasta que se devuelva todo. El usuario no puede crear nuevos préstamos hasta que todo el material haya sido devuelto."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் எல்லா பொருட்களையும் குறிக்கவில்லை, இதன் பொருள் பயனர் அவற்றைத் திரும்பக் கொண்டு வரவில்லை, மேலும் அவை அனைத்தும் திரும்பப் பெறும் வரை கடன் நிலுவையில் வைக்கப்படும். அனைத்து பொருட்களும் வழங்கப்படும் வரை பயனர் புதிய கடன்களை உருவாக்க முடியாது."
          }
        }
      }
    },
    "management_return_screen_skip_warning_title": {
