    "management_pickup_screen_skip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip Inventory Check"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Saltar Comprovació d'Inventari"
          }
        },
        "es": {
          "stringUnit": {
