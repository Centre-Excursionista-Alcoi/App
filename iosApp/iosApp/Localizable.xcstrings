    "passkey_explanation_action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a passkey"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una passkey"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una passkey"
          }
        }
      }
    },
    "passkey_explanation_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A passkey lets you sign in with your fingerprint, your face or your phone's PIN, the same way you unlock your phone. There's no password to remember or type, and nobody can guess it or steal it. Your phone keeps it safe, and it's also saved in your Google or Apple account, so you won't lose it if you change phones."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una passkey et permet iniciar sessió amb la teua empremta, cara o el pin del teu mòbil, de la mateixa manera que el desbloqueges. No cap escriure o recordar cap contrasenya, i ningú la pot furtar o endevinar. El teu mòbil la mantè segura, i també es guarda en el teu compte de Google o Apple per a que no la pergues si canvies de mòbil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una passkey te permite iniciar sesión con tu huella, cara o el pin de tu móvil, de la misma manera que desbloqueas el dispositivo. No hay contraseña que recordar o escribir, y nadie la puede adivinar o robar. Tu móvil la mantiene segura, y también se guarda a tu cuenta de Google o Apple para que no la pierdas en caso de cambiar de móvil."
          }
        }
      }
    },
    "passkey_explanation_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with your phone's screen lock"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia la sessió amb la pantalla de bloqueig del teu mòbil"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con la pantalla de bloqueo de tu móvil"
          }
        }
      }
    },
