    "settings_report_analytics_summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If enabled, the app will collect usage statistics to help improve the app."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si està habilitat, l'app recol·lectarà automàticament analítiques d'ús per a millorar-la."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está habilitado, la app recolectará automaticamente analiticas de uso para mejorarla."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயக்கப்பட்டால், பயன்பாட்டை மேம்படுத்த உதவும் பயன்பாட்டு புள்ளிவிவரங்களை ஆப்ச் சேகரிக்கும்."
          }
        }
      }
    },
