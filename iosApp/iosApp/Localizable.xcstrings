        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per favor, programa la devolució amb el teu administrador assignat el més prompte possible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, programa la devolución con tú administrador asignado lo más pronto posible."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தயவு செய்து, உங்களுக்கு ஒதுக்கப்பட்ட நிர்வாகியுடன் கூடிய விரைவில் வருமானத்தை திட்டமிடவும்."
