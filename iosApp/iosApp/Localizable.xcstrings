    "permission_camera_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please, grant access to access your camera so that the scanner can be launched."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per favor, dona accés a la teua càmera per a poder iniciar l'escàner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, permite el acceso a tu cámara para poder iniciar el escáner."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தயவு செய்து, உங்கள் கேமராவை அணுகுவதற்கான அணுகலை வழங்கவும், இதனால் ச்கேனரை இயக்க முடியும்."
          }
        }
      }
    },
    "permission_camera_title": {
      "extractionState": "manual",
      "localizations": {
