    "delete_dialog_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete \"%1$@\"? This action cannot be undone."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Segur que vols eliminar \\\"%1$@\\\"? Aquesta acció no es pot desfer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguro que quieres eliminar \\\"%1$@\\\"? Esta acción no se puede deshacer."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "\\\"%1$@\\\" ஐ நிச்சயமாக நீக்க விரும்புகிறீர்களா? இந்தச் செயலைச் செயல்தவிர்க்க முடியாது."
          }
        }
      }
    },
    "delete_dialog_no_name_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete this element? This action cannot be undone."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Segur que vols eliminar aquest element? L'acció no es pot desfer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Segur que vols eliminar aquest element? Aquesta acció no es pot desfer."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த உறுப்பை நிச்சயமாக நீக்க விரும்புகிறீர்களா? இந்தச் செயலைச் செயல்தவிர்க்க முடியாது."
          }
        }
      }
    },
