    "login_forgot_password_dialog_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your email, and if you have been registered before, you will receive an email to set a new password. If you signed in with a passkey, it stops working, and you can create a new one afterwards."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdueix el teu correu, i si t'has registrat abans, rebràs un correu electrònic per a establir una contrasenya nova. Si inicies sessió amb una passkey, i deixa de funcionar, pots crear una nova més tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tu correo electrónico, y si te has registrado antes, recibirás un correo para establecer una nueva contraseña. Si inicias sesión con una passkey, dejará de funcionar y deberás crear una nueva."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மின்னஞ்சலை உள்ளிடவும், நீங்கள் முன்பே பதிவு செய்திருந்தால், உங்கள் கடவுச்சொல்லைப் புதுப்பிக்க மின்னஞ்சலைப் பெறுவீர்கள்."
          }
        }
      }
    },
    "login_forgot_password_dialog_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't sign in?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No pots accedir?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes acceder?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கடவுச்சொல்லை மறந்துவிட்டீர்களா?"
          }
        }
      }
    },
    "login_forgot_password_success_title": {
      "extractionState": "manual",
