    "settings_remove_account_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you accept, your account and all of its associated data will be removed from the server. Your session will be closed, and you won't be able to log in again. Please note that this won't remove yourself from the club, you will have to contact the respective authorities to do so. This will effectively remove all the data associated with you from the app's servers."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si acceptes, el teu compte i totes les dades associades seran eliminades del servidor. La teua sessió serà tancada, i no podràs tornar a iniciar-la. Per favor, tingues en compte que açò no et dona de baixa del club, i hauràs de contactar amb els gestors pertinents. Aquesta acció només elimina de manera efectiva les teues dades exclusivament dels servidors de l'app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aceptas, tu cuenta y todos los datos asociados serán eliminados del servidor. Tu sesión será cerrada, y no podrás volver a iniciarla. Por favor, ten en cuenta que esto no te elimina del club, tendrás que contactar con las autoridades pertinentes para ello. Esta acción eliminará de manera efectiva e inmediata tus datos del servidor de la app."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஏற்றுக்கொண்டால், உங்கள் கணக்கு மற்றும் அதனுடன் தொடர்புடைய அனைத்து தரவுகளும் சேவையகத்திலிருந்து அகற்றப்படும். உங்கள் அமர்வு மூடப்படும், மேலும் உங்களால் மீண்டும் உள்நுழைய முடியாது. இது உங்களை கிளப்பில் இருந்து நீக்காது என்பதை நினைவில் கொள்ளவும், அவ்வாறு செய்ய சம்பந்தப்பட்ட அதிகாரிகளை நீங்கள் தொடர்பு கொள்ள வேண்டும். இது பயன்பாட்டின் சேவையகங்களிலிருந்து உங்களுடன் தொடர்புடைய எல்லா தரவையும் திறம்பட அகற்றும்."
          }
        }
      }
    },
    "settings_remove_account_summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes your account and all of its associated data from the server. This action cannot be undone."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina el teu compte i totes les dades associates del servidor. Aquesta acció no es pot desfer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tu cuenta y todos los datos asociados del servidor. Esta acción no es reversible."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கணக்கையும் அதனுடன் தொடர்புடைய எல்லா தரவையும் சேவையகத்திலிருந்து நீக்குகிறது. இந்தச் செயலைச் செயல்தவிர்க்க முடியாது."
          }
        }
      }
    },
    "settings_remove_account_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove Account"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar Compte"
          }
        },
        "es": {
          "stringUnit": {
