        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo has devuelto una parte del préstamo. Por favor, recuerda retornarlo todo lo más pronto posible."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கடனில் சில பொருட்களை திருப்பி அளித்துள்ளீர்கள். தயவு செய்து, மீதமுள்ள பொருட்களை விரைவில் திருப்பித் தர நினைவில் கொள்ளுங்கள்."
          }
