        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon tu dispositivo cerca de la etiqueta NFC para registrarlo automaticamente."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உருப்படியை தானாகப் பதிவு செய்ய உங்கள் சாதனத்தை NFC குறிச்சொல்லுக்கு அருகில் வைக்கவும்."
