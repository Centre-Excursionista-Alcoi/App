            "state": "translated",
            "value": "Por favor, comprueba tu bandeja de entrada."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தயவுசெய்து, உங்கள் இன்பாக்சைச் சரிபார்க்கவும்."
          }
        }
      }
