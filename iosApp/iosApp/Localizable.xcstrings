    "lending_creation_warning_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will reserve the allocated items for the selected dates, but the request has to be approved by an administrator before the lending is complete.\nOnce an admin confirms the lending, you will receive a notification, and will be able to schedule the pickup of the items."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Reservaràs el material per a les dates seleccionades, però la teua sol·licitud a de ser aprovada per un administrador abans de ser completada.\nUna vegada es confirme la teua reserva, rebràs una notificació, i podràs programar la recollida del material."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reservarás el material para las fechas seleccionadas, pero la petición tiene que ser aceptada antes por un administrador para completarla.\nCuando se confirme el préstamo, recibirás una notificación, y podrás programar la recogida."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுக்கப்பட்ட தேதிகளுக்கு ஒதுக்கப்பட்ட உருப்படிகளை நீங்கள் முன்பதிவு செய்வீர்கள், ஆனால் கடன் வழங்குவது முடிவதற்கு முன்பு கோரிக்கையை நிர்வாகி அங்கீகரிக்க வேண்டும். \nஒரு நிர்வாகி கடனை உறுதி செய்தவுடன், நீங்கள் அறிவிப்பைப் பெறுவீர்கள், மேலும் பொருட்களை பிக்அப் செய்ய திட்டமிட முடியும்."
          }
        }
      }
    },
