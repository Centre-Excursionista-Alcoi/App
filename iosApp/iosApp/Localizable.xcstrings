    "insurance_add_info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When adding an insurance here, you guarantee that the information provided is true and complete. You will be held responsible for any inaccuracies."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En afegir un segur, guaranteixes que la informació introduïda és correcta i completa. Seràs el responsable de qualsevol inexactitud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando añades un seguro aquí, garantizas que la información proporcionada es cierta y completa. Serás responsable de cualquier inexactitud."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இங்கே காப்பீட்டைச் சேர்க்கும் போது, வழங்கப்பட்ட செய்தி உண்மை மற்றும் முழுமையானது என்று பொறுப்பு அளிக்கிறீர்கள். ஏதேனும் தவறுகளுக்கு நீங்கள் பொறுப்பாவீர்கள்."
          }
        }
      }
    },
