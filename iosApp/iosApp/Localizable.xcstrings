    "notification_lending_returned_partial_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have returned some items of your lending. Please, remember to return the remaining items as soon as possible."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Només has tornat una part del préstec. Per favor, recorda retornar-ho tot el més prompte possible."
