    "lending_details_memory_pending_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please, prepare and upload the memory of the activity as soon as possible. You can't make another request until you do this."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per favor, prepara i puja/escriu la memòria de l'activitat el més prompte possible. No pots fer una altra petició fins que ho faces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, prepara y sube/escribe tu memoria de la actividad lo más pronto posible. No puedes hacer otra alta de petición hasta que lo hagas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தயவு செய்து, செயல்பாட்டின் நினைவகத்தை விரைவில் ஆயத்தம் செய்து பதிவேற்றவும். நீங்கள் இதைச் செய்யாத வரை நீங்கள் மற்றொரு கோரிக்கையை வைக்க முடியாது."
          }
        }
      }
    },
