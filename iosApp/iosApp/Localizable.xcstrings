        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nueva versión de la app está disponible. Por favor, actualiza a la última versión para tener una mejor experiencia."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயன்பாட்டின் புதிய பதிப்பு கிடைக்கிறது. சிறந்த அனுபவத்திற்காக, அண்மைக் கால பதிப்பிற்கு புதுப்பிக்கவும்."
          }
