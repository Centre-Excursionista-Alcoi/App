    "lending_details_nfc_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place your device near the NFC tag to register the item automatically."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Posa el teu dispositiu prop de l'etiqueta NFC per a registrar-lo automàticament."
