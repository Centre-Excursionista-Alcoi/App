    "notification_lending_returned_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have returned the items of your lending. Please, remember to upload the memory of the activity."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has tornat els elements del teu préstec. Per favor, recorda pujar la memòria de l'activitat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has devuelto los elementos de tú préstamo. Por favor, recuerda subir la memoria de la actividad."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் கடன் கொடுத்த பொருட்களைத் திருப்பிக் கொடுத்துவிட்டீர்கள். செயல்பாட்டின் நினைவகத்தைப் பதிவேற்ற நினைவில் கொள்ளவும்."
          }
        }
      }
    },
