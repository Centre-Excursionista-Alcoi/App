        }
      }
    },
    "management_pickup_screen_skip_warning_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure that you want to skip the inventory check? Make sure all the items have been delivered to the user, and that they match the references assigned."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Segur que vols saltar la comprovació d'inventari? Has d'estar segur que tot el material ha sigut entregat a l'usuari, i que les referències coincideixen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguro que quieres saltar la comprobación de inventario? Debes estar seguro de haber entregado todo el material al usuario, y que coincide con las referencias asignadas."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரக்கு சரிபார்ப்பை நிச்சயமாக தவிர்க்க விரும்புகிறீர்களா? அனைத்து பொருட்களும் பயனருக்கு வழங்கப்பட்டுள்ளதையும், அவை ஒதுக்கப்பட்ட குறிப்புகளுடன் பொருந்துவதையும் உறுதிசெய்யவும்."
          }
        }
      }
    },
    "management_pickup_screen_skip_warning_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skipping inventory check"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Saltant la comprovació d'inventari"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saltando comprobación de inventario"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இருப்புச் சரிபார்ப்பைத் தவிர்க்கிறது"
          }
        }
      }
    },
