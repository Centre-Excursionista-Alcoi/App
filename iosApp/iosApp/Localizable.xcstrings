    "settings_report_session_summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If enabled, the app will collect session replay data to help improve user experience."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Si està habilitat, l'app recol·lectarà automàticament dades de reproducció de sessions per a millorar l'experiència d'usuari."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está habilitado, la app recolectará automaticamente datos de reproducción de sesiones para a mejorar la experiencia de usuario."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயக்கப்பட்டால், பயனர் அனுபவத்தை மேம்படுத்துவதற்கு, அமர்வு மறு இயக்கத் தரவை ஆப்ச் சேகரிக்கும்."
          }
        }
      }
    },
