    "femecv_credentials_invalid_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FEMECV no longer accepts the username or password you saved, so your licenses are not being updated. Sign in again to keep them in sync."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La FEMECV ja no accepta l'usuari o la contrasenya que vas guardar, així que les teues llicències no s'estan actualitzant. Torna a iniciar sessió per mantindre-les sincronitzades."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La FEMECV ya no acepta el usuario o la contraseña que guardaste, así que tus licencias no se están actualizando. Vuelve a iniciar sesión para mantenerlas sincronizadas."
          }
        }
      }
    },
