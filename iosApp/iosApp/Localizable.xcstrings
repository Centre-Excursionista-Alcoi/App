    "login_error_browser_expired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in in the browser expired. Try again."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'inici de sessió al navegador ha caducat. Torna-ho a provar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión en el navegador ha caducado. Inténtalo de nuevo."
          }
        }
      }
    },
    "login_error_invalid_credentials": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your email or password is not valid. Please, check with an administrator that the email you have in the database is the correct one."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu correu electrònic o contrasenya no són vàlids."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu correo electrónico o contraseña no son válidos. Por favor, comprueba junto a un administrador que el correo electrónico de la base de datos es el correcto."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் மின்னஞ்சல் அல்லது கடவுச்சொல் தவறானது. தரவுத்தளத்தில் நீங்கள் வைத்திருக்கும் மின்னஞ்சல் சரியானதா என்பதை நிர்வாகியுடன் சரிபார்க்கவும்."
          }
        }
      }
    },
    "login_error_passkey": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The passkey couldn't be used: %1$@"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La passkey no es pot fer servir: %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La passkey no se ha podido usar: %1$@"
          }
        }
      }
    },
    "login_error_password_not_set": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account signs in with a passkey, not a password. Tap \"Sign in with a passkey or saved password\" above."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest compte inicia la sessió amb una passkey, no una contrasenya. Toca Accedir amb una passkey o contrasenya desada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta inicia sesión con una passkey, no con contraseña. Toca Iniciar sesión con una passkey o contraseña guardada."
          }
        }
      }
    },
    "login_error_password_not_set_desktop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account signs in with a passkey. Use “Sign in with your browser” to use it, or add a password from Security & Privacy in the app on your phone."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquest compte accedeix amb una passkey. Fes servir «Inicia sessió amb el navegador» per utilitzar-la, o afegeix una contrasenya des de Seguretat i Privacitat en l'app del teu mòbil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta inicia sesión con una passkey. Usa «Iniciar sesión con el navegador» para utilizarla, o añade una contraseña en Seguridad y Privacidad de la app de tu móvil."
          }
        }
      }
    },
