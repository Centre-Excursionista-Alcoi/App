    "lending_details_incomplete_return_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have returned some items, but others are missing. Please, return everything as soon as possible."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Has tornat una part del material, però encara falten coses. Per favor, retorna tot el més prompte possible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has devuelto una parte del material, pero aún faltan cosas. Por favor, devuelve todo lo más pronto posible."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் சில பொருட்களை திருப்பி அளித்துள்ளீர்கள், ஆனால் மற்றவை காணவில்லை. தயவு செய்து எல்லாவற்றையும் சீக்கிரம் திருப்பித் தரவும்."
          }
        }
      }
    },
