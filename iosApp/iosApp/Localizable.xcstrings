    "login_existing_account_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already have an account saved on this device (%1$@). Log out from it before adding a different one?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La tens un compte desat en aquest dispositiu (%1$@). Vols tancar la sessió abans d'afegir-ne un de nou?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya tienes una cuenta guardada en este dispositivo (%1$@). Cerrar la sesión antes de añadir una diferente?"
          }
        }
      }
    },
