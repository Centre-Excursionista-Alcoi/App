      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An admin will get in touch with you to schedule a pickup."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Un administrador es posarà en contacte amb tú per a programar la recollida."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un admin se pondrá en contacto contigo para programar una recogida."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பிக்-அப்பைத் திட்டமிட ஒரு நிர்வாகி உங்களைத் தொடர்புகொள்வார்."
