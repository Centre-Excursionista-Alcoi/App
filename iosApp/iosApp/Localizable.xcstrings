          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recolectar analiticas de uso"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயன்பாட்டு பகுப்பாய்வுகளை சேகரிக்கவும்"
          }
        }
      }
    },
    "settings_report_errors_summary": {
      "extractionState": "manual",
