    "activities_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here you can see the activities you have been tagged in. You can read them, but only their author can edit them."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ací pots veure les activitats en les què has sigut etiquetat. Pots veure-les, però només l'autor les pots editar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí puedes ver las actividades en las que has sido etiquetado. Puedes verlas, pero solo el autor puede editarlas."
          }
        }
      }
    },
