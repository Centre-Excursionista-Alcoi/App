    "permission_notification_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please, grant access to send you notification so that we can keep you up to date with your lendings."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per favor, garanteix accés per enviar-te notificacions per a que puguem mantindre't al dia amb els teus préstecs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, permítenos mandarte notificaciones para poder mantenerte al día con tus préstamos."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தயவு செய்து, உங்களுக்கு அறிவிப்பை அனுப்புவதற்கான அணுகலை வழங்கவும், இதன் மூலம் உங்கள் கடன்களை நாங்கள் உங்களுக்குப் புதுப்பித்த நிலையில் வைத்திருக்க முடியும்."
          }
        }
      }
    },
